# Ea Level 2 managed runtime example configuration.
# PLACEHOLDERS ONLY. Never commit production secrets.

EA_ENV=staging
EA_LEVEL=level_2a

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ea
WEBHOOK_BASE_URL=https://REPLACE.example.com

GOOGLE_CLOUD_PROJECT=REPLACE
GMAIL_PUBSUB_TOPIC=projects/REPLACE/topics/ea-gmail-watch
GMAIL_WATCH_USER=me
CALENDAR_ID=primary

OPENAI_API_KEY=REPLACE
EA_SECRET_STORE=REPLACE
EA_AUDIT_DESTINATION=REPLACE
EA_WEBHOOK_AUTH_MODE=google_verified_delivery

# Must remain false while Level 2B is HOLD.
EA_LEVEL_2B_ENABLED=false
EA_EXTERNAL_SEND_ENABLED=false
EA_EXTERNAL_CALENDAR_ENABLED=false
