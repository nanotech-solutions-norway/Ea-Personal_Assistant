        "RFQ_RECEIVED"
      ],
      "owner_routine": "Ea Business Email Watch + scoped document engine",
      "stages": [
        {
          "name": "REUSE_CASE",
          "require": [
            "prior stage and source IDs",
            "distinct product opportunities preserved"
          ]
        },
        {
          "name": "VERIFY_RFQ",
          "require": [
            "original request",
            "exact buyer legal role",
            "product/variant",
            "quantity",
            "currency",
            "delivery scope"
          ]
        },
        {
          "name": "PRICE_SOURCE",
          "require": [
            "current approved source",
            "supplier terms if necessary",
            "no inferred freight",
            "operator pricing gate"
          ]
        },
        {
          "name": "RENDER_QUOTE",
          "require": [
            "canonical Quote template and 05D reference",
            "separate invoice SOP",
            "independent arithmetic and A4 visual QA"
          ]
        },
        {
          "name": "ATTACH_AND_DRAFT",
          "require": [
            "quote PDF and exact draft wording agree",
            "no superseded attachment",
            "Gmail source readback",
            "03D/03F"
          ]
