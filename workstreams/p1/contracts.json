        {
          "name": "PROJECT_STATUS",
          "require": [
            "CRM Activity + Opportunity",
            "Order Book Document_Index where authorized",
            "source revisions",
            "independent write readback"
          ]
        },
        {
          "name": "OPERATOR_REVIEW",
          "require": [
            "validate full text+quote+price+files before external issue"
          ]
        }
      ],
      "internal_complete": "QUOTE_AND_DRAFT_VERIFIED or PENDING_REVIEW with blockers",
