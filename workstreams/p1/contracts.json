  "workflow_definitions": [
    {
      "id": "EA.COM.INQUIRY_TO_REPLY.v0.1",
      "trigger": [
        "NEW_LEAD",
        "INBOUND_REPLY"
      ],
      "owner_routine": "Ea Business Email Watch",
      "stages": [
        {
          "name": "MATCH_CASE",
          "require": [
            "exact immutable identifiers or review"
          ]
        },
        {
          "name": "READ_CONTEXT",
          "require": [
            "full relevant thread",
            "prior SENT",
            "related correspondence",
            "03D suppression",
            "sender alias",
            "latest source revision"
          ]
        },
        {
          "name": "VERIFY_PRODUCT",
          "require": [
            "exact formulation",
            "APPROVED/CANONICAL technical claims",
            "recipient fit",
            "price only if requested"
          ]
        },
        {
          "name": "PREPARE_DRAFT",
          "require": [
            "03F zero authored signatures",
            "valid reply anchor",
            "one in-thread draft",
            "manufacturer nondisclosure"
          ]
        },
        {
          "name": "DRAFT_QA",
          "require": [
            "provider draft readback",
            "matching actual attachment IDs/versions",
            "no sent message"
          ]
        },
        {
          "name": "PROJECTION",
          "require": [
            "CRM owner and row readback",
            "idempotent source event",
            "append verified activity",
            "next action"
          ]
        },
        {
          "name": "OPERATOR_REVIEW",
          "require": [
            "new exact-revision operator authorization to send"
          ]
        }
      ],
      "internal_complete": "DRAFT_VERIFIED or BLOCKED_SOURCE with case disposition",
      "external_status": "AWAITING_OPERATOR_APPROVAL"
    },
    {
      "id": "EA.COM.RFQ_TO_QUOTE_DRAFT.v0.1",
